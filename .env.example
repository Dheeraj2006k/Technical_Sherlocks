# Copy to .env.local and fill in. Server-side only: never prefix with NEXT_PUBLIC_ (except the two public realtime vars at the bottom).
# Use the DEV Supabase project locally; event-day values live only in Vercel env.

# Pooled (transaction-mode) Postgres connection string
DATABASE_URL=
# Low-privilege login role that runs player SQL. Written for you by: node scripts/setup-player-role.mjs
DATABASE_URL_PLAYER=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
ADMIN_PASSWORD=

# Realtime (optional; without these the app polls every 3s). Public by design: the anon key only lets a
# browser listen for data-free "changed" pings on a team's unguessable channel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Per-IP join attempt limits (defaults 10/min, 30/hour). Raise these for the event: a whole venue may share one public IP.
JOIN_RATE_PER_MINUTE=
JOIN_RATE_PER_HOUR=
